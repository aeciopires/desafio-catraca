# Catraca — environment variables (all optional: every value below is the default).
# Copy to .env only if you need to change something; `make up` works without it.
# Documented in docs/operations/configuracao.md.

# --- Project / ports (change if a port is already in use) ---
COMPOSE_PROJECT_NAME=catraca
APP_PORT=8080            # product UI + partner API ($WEB = $API)
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
LOKI_PORT=3100

# --- Behaviour ---
OBSERVABILITY=1          # 1 = start Prometheus/Grafana/Jaeger/Loki/Collector; 0 = product only
GATEWAY_MODE=simulated   # only mode available in the MVP (no real payment keys)
GATEWAY_DELAY_SCALE=1    # multiplies simulated gateway delays (tests use 0.1); keep 1 for evaluation
WORKER_POLL_MS=200       # how often the worker looks for due payment decisions
LOG_LEVEL=info
PARTNER_API_KEY=catraca-partner-key-dev
SESSION_SECRET=local-dev-session-secret-change-me-0123456789

# --- Scripts ---
UP_TIMEOUT=180           # seconds to wait for healthchecks in `make up`
ALLOW_UNSUPPORTED_OS=0   # 1 = run outside the supported OS matrix (at your own risk)
TEST_GATEWAY_DELAY_SCALE=0.1  # gateway scale used by `make test-*`
