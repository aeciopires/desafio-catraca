{
  "name": "catraca",
  "version": "1.0.0",
  "private": true,
  "description": "Catraca - ticket sales MVP for small events (built in agent mode)",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "start:worker": "node src/worker/main.ts",
    "migrate": "node src/db/migrate.ts",
    "seed": "node src/db/seed.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "toc": "node scripts/gen-toc.mjs",
    "toc:check": "node scripts/gen-toc.mjs --check",
    "check:spec": "node scripts/check-spec.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/formbody": "9.0.2",
    "@fastify/swagger": "9.9.5",
    "@fastify/swagger-ui": "6.1.5",
    "@fastify/view": "12.0.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "bcryptjs": "3.0.3",
    "ejs": "7.0.2",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/ejs": "3.1.5",
    "@types/node": "26.6.11",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
