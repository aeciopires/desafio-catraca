<%- include('../partials/header') %>
<h1>Meus ingressos</h1>
<% if (flash) { %><p class="flash" data-testid="flash"><%= flash %></p><% } %>
<p class="muted">O pagamento é processado em segundo plano: recarregue a página para ver o status atualizado.</p>
<% if (!tickets.length) { %>
<p class="muted" data-testid="tickets-empty">Você ainda não comprou ingressos.</p>
<% } else { %>
<table>
  <thead><tr><th>Evento</th><th>Data</th><th>Status</th><th>Código</th></tr></thead>
  <tbody>
  <% tickets.forEach(function (ticket) { %>
    <tr data-testid="ticket-row" data-ticket-id="<%= ticket.id %>">
      <td data-testid="ticket-event"><%= ticket.event_name %></td>
      <td><%= formatDateTimeBR(new Date(ticket.event_starts_at)) %></td>
      <td data-testid="ticket-status"><%= statusLabels[ticket.status] %></td>
      <td><code data-testid="ticket-code"><%= ticket.code %></code></td>
    </tr>
  <% }) %>
  </tbody>
</table>
<% } %>
<%- include('../partials/footer') %>
